  m_text: "\u30FB\u3053\u306E\u30B2\u30FC\u30E0\u306F\u767E\u4EBA\u4E00\u9996\u3092\u30E2\u30C1\u30FC\u30D5\u306B\u3057\u305F\u5BFE\u6226\u30AB\u30FC\u30C9\u30B2\u30FC\u30E0\u3067\u3059\u3002\n\u30FB\u5834\u306B\u306F\u300C\u30B9\u30DA\u30EB\u30AB\u30FC\u30C9\u300D\u3068\u300C\u30DB\u30EF\u30A4\u30C8\u30AB\u30FC\u30C9\u300D\u304C50\u679A\u305A\u3064\u3042\u308A\u307E\u3059\u3002\n\u30FB\u5148\u653B\u5F8C\u653B\u304C\u30E9\u30F3\u30C0\u30E0\u306B\u9078\u3070\u308C\u3001\u30B9\u30DA\u30EB\u30AB\u30FC\u30C9\u304C2\u679A\u305A\u3064\u914D\u3089\u308C\u307E\u3059\u3002\n\u30FB\u81EA\u5206\u306E\u624B\u756A\u306B\u306A\u3063\u305F\u3089\u3001\u5C71\u672D\u304B\u3089\u30B9\u30DA\u30EB\u30AB\u30FC\u30C9\u30921\u679A\u5F15\u304D\u307E\u3059\u3002\n\u30FB\u624B\u672D3\u679A\u306E\u3046\u3061\u304B\u30891\u679A\u9078\u3073\u3001\u52B9\u679C\u3092\u767A\u52D5\u3055\u305B\u3001\u5893\u5730\u306B\u9001\u308A\u307E\u3059\u3002\n\u30FB\u30B9\u30DA\u30EB\u30AB\u30FC\u30C9\u306B\u306F\u8272\u3005\u306A\u52B9\u679C\u304C\u3042\u308A\u307E\u3059(\u306A\u304A\u3001\u5E38\u306B\u4E92\u3044\u306E\u624B\u672D\u306F\u898B\u3048\u307E\u3059)\u3002\n\u30FB\u3053\u308C\u3092\u3001\u5C71\u672D\u304C\u7121\u304F\u306A\u308B\u307E\u3067\u7E70\u308A\u8FD4\u3057\u307E\u3059\u3002\n\u30FB\u5F8C\u653B\u304C\u6700\u5F8C\u306B\u30B9\u30DA\u30EB\u30AB\u30FC\u30C9\u3092\u4F7F\u7528\u3057\u305F\u3089\u3001\u30B2\u30FC\u30E0\u304C\u7D42\u4E86\u3057\u307E\u3059\u3002\n\u30FB\u6700\u7D42\u7684\u306B\u30DB\u30EF\u30A4\u30C8\u30AB\u30FC\u30C9\u304C\u591A\u3044\u65B9\u306E\u52DD\u5229\u3067\u3059(\u540C\u6570\u306E\u5834\u5408\u306F\u5148\u653B\u304C\u52DD\u5229)\u3002\n\u30FB\u307E\u305F\u3001\u9014\u4E2D\u3067\u904E\u534A\u6570\u306E26\u679A\u3092\u8490\u96C6\u3057\u305F\u5834\u5408\u3082\u52DD\u5229\u306B\u306A\u308A\u307E\u3059(KO)\u3002\n\u30FB\u6B63\u76F4\u3001\u904A\u3093\u3067\u307F\u308C\u3070\u30EB\u30FC\u30EB\u306F\u5206\u304B\u308B\u3068\u601D\u3044\u307E\u3059\u3002"
